# Copy to .env.local and fill in. Never commit the real .env.local (it's gitignored).

# ---- Firebase client config (public — safe in the browser) ----
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- Firebase Admin (SECRET — server only, never expose to the client) ----
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="paste the full private key here, keep the \n escapes, wrap in quotes"

# ---- Site origin (used for CORS allow-list + Grow success/cancel/notify URLs) ----
NEXT_PUBLIC_SITE_ORIGIN=https://mekapele.com

# ---- Grow (Meshulam) payment gateway — from your Grow onboarding ----
GROW_PAGE_CODE=
GROW_USER_ID=
# Sandbox by default. Switch to the production host once real payments are verified:
# GROW_API_BASE=https://secure.meshulam.co.il/api/light/server/1.0
GROW_API_BASE=https://sandbox.meshulam.co.il/api/light/server/1.0
