# Copy to .env.local and fill in. Never commit the real .env.local (it's gitignored).

# ---- Firebase client config (public — safe in the browser) ----
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- Firebase Admin (SECRET — server only, never expose to the client) ----
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="paste the full private key here, keep the \n escapes, wrap in quotes"

# ---- Site origin (used for CORS allow-list + Grow success/cancel URLs) ----
NEXT_PUBLIC_SITE_ORIGIN=https://mekapele.com

# ---- Grow payment, created via a Make.com scenario (see SAAS_SETUP.md) ----
# The "Custom webhook" trigger URL from your Make.com scenario. Our server
# POSTs { sum, description, userId, packageId, heartsAdded, successUrl,
# cancelUrl } here and expects back JSON: { "paymentUrl": "..." }.
MAKE_CHECKOUT_WEBHOOK_URL=
# From Grow dashboard -> Webhooks -> create a webhook pointed at
# https://mekapele.com/api/webhooks/grow (type: "עדכון לאחר ביצוע עסקה", format: JSON).
# This is called directly by Grow, not through Make. The webhook is rejected
# (fail closed) if this doesn't match.
GROW_WEBHOOK_KEY=
