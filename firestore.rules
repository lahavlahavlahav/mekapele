rules_version = '2';

// =============================================================================
// FIRESTORE SECURITY RULES — Mekapele SaaS
// -----------------------------------------------------------------------------
// Principles:
//   • A user may read/write ONLY documents they own (userId == request.auth.uid).
//   • Billing lives in `subscriptions/{uid}` (monthly pass end date) and
//     `pendingCredits/*` — both fall under the default deny below, so no
//     client can read or write them. Only the Admin SDK (server / webhooks),
//     which bypasses these rules, touches them; the browser reads its status
//     through GET /api/subscription.
//   • `transactions/*` records are never writable by clients, and only
//     readable by the owning user (for order-history UI). Only the Admin SDK
//     (create-checkout + the Grow webhook) creates/updates them.
//   • Unauthenticated access is denied everywhere.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helpers --------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ---- User profile ---------------------------------------------------
    match /users/{userId} {

      // Owner can read their own profile.
      allow read: if isOwner(userId);

      // User docs are created server-side (Admin SDK) on first login.
      allow create: if false;

      // Owner may update their own profile (it holds no billing data).
      allow update: if isOwner(userId);

      // No client deletes of user docs.
      allow delete: if false;

      // ---- Saved patterns ----------------------------------------------
      match /patterns/{patternId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.userId == userId;
        allow update: if isOwner(userId)
          && resource.data.userId == userId
          && request.resource.data.userId == userId;
        allow delete: if isOwner(userId);
      }

      // ---- Projects (legacy saved patterns) -----------------------------
      // Owned subcollection: full CRUD for the owner, scoped to their uid.
      match /projects/{projectId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.userId == userId;
        allow update: if isOwner(userId)
          && resource.data.userId == userId
          && request.resource.data.userId == userId;
        allow delete: if isOwner(userId);
      }
    }

    // ---- Payment transactions --------------------------------------------
    // Created/updated only by the Admin SDK (create-checkout + Grow webhook).
    // The owner may read their own order history; nobody writes from the client.
    match /transactions/{transactionId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // ---- Default deny ---------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
